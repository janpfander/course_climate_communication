# Local-only notes — never commit: the early syllabus template, reading
# options for slide preparation, readings removed from the syllabus
/notes/

# Resources from other courses (local reference only, not ours to publish)
/resources/

# Email drafts to students (local only)
/emails/

# Student data: roster, group assignment, group list PDF (local only, this
# repo is public). The second line guards against a rendered copy.
/students/
/docs/students/

# Credentials for the email send scripts
.Renviron
.Rprofile

# PowerPoint slide sources stay local; only the exported PDF is committed
*.pptx

# Quarto
/.quarto/

# OS
.DS_Store

# R/RStudio (unused here, kept in case RStudio is opened)
.Rproj.user
.Rhistory
.RData
.Ruserdata

**/*.quarto_ipynb

# generated by index.qmd at render time (served copy lives in docs/)
/course-sessions.ics

# rendered copy of the local-only resources/ folder
/docs/resources/
